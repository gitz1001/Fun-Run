# Google Drive folder used for proof-of-payment uploads.
# The Google account authorised by GOOGLE_REFRESH_TOKEN must have access to this folder.

# --- staff dashboard --------------------------------------------------
# STAFF_PASSWORD turns the dashboard on. STAFF_SECRET is optional but better
# set: it signs the session cookie, and changing it signs every staff member out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_PASSWORD=
STAFF_SECRET=
SITE_URL=

# Postgres — from Vercel > Storage > Neon > .env.local tab
